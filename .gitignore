# ═══════════════════════════════════════════════════════════════════════════════
# DeepGuard AI — .gitignore completo
# Cubre: Python · FastAPI · Celery · Redis · Docker · Next.js · Node.js
#        CUDA · PyTorch · HuggingFace · Windows · Linux · VSCode · JetBrains
# ═══════════════════════════════════════════════════════════════════════════════


# ── SECRETOS Y VARIABLES DE ENTORNO ──────────────────────────────────────────
# NUNCA subir archivos con credenciales reales
.env
.env.local
.env.*.local
# Permitir SOLO los ejemplos documentados sin credenciales reales
!.env.example
!.env.production.example
!.env.worker.example


# ── DATOS SENSIBLES GENERADOS EN RUNTIME ─────────────────────────────────────
# Archivos subidos por usuarios (privacidad + tamaño)
backend/uploads/
uploads/

# Reportes forenses con datos de análisis reales
reports/tasks/
reports/custody/
backend/reports/

# Mediciones crudas: los CSV de puntuaciones se reconstruyen con
# scripts/score_dataset_v2.py y scripts/score_heldout_detectores.py y suman
# ~25 MB. Se versiona el REGISTRO (los .md y los .json de resumen), no la
# materia prima. Excepcion: heldout_detectores.csv (117 KB) es la evidencia
# directa de la tabla de AUC por detector, medida fuera de muestra.
reports/*.csv
!reports/heldout_detectores.csv
# Copias de seguridad de modelos descartados durante la seleccion
reports/backup_*/
# Respaldos tomados antes de un reentrenamiento. Son copias de los .joblib
# que ya estan versionados en models/, asi que versionarlas duplicaria los
# binarios. Las MEDICIONES que acompanan al respaldo si se versionan: se
# restauran a reports/ cuando el reentrenamiento se descarta.
reports/snapshot_*/
reports/.snapshot_actual

# Logs del sistema (pueden contener rutas, IPs, datos de debug)
logs/
*.log
celery_*.log
backend_*.log
frontend_*.log


# ── MODELOS DE IA (demasiado grandes para Git, usar HuggingFace Hub) ──────────
# Total aproximado: 19+ GB — NUNCA en Git, se descargan automáticamente
# /models/* ignora el contenido del directorio raíz (pesos HuggingFace), NO
# backend/app/models/. Se usa /models/* en vez de /models/ porque git no
# desciende a un directorio excluido: con la forma /models/ las excepciones de
# abajo no tendrían efecto.
/models/*
# Excepción: los artefactos del meta-ensemble son pequeños (~235 KB) y el
# sistema no funciona sin ellos, así que sí se versionan. meta_classifier.joblib
# ya estaba trackeado; sin esta excepción el cabezal sin-arte quedaría fuera del
# repo y un despliegue limpio se quedaría sin él.
!/models/meta_ensemble/
/models/meta_ensemble/*.bak
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
# Caché de HuggingFace
.cache/
huggingface/


# ── DATOS DE ENTRENAMIENTO (usar Git LFS o enlace externo) ───────────────────
# Los conjuntos de imágenes no van al repositorio: son decenas de GB y se
# reconstruyen con scripts/download_dataset_v3.py y los descargadores de
# FaceForensics++. Lo que sí se versiona son los artefactos entrenados
# (models/meta_ensemble/) y los scripts que los producen.
data/


