*.tar
*.tar.gz
docker-volumes/
# Datos de contenedores locales
postgres_data/
redis_data/
mysql_data/


# ── BINARIOS GRANDES (usar Git LFS si son necesarios) ────────────────────────
*.docx
*.xlsx
*.pptx
*.pdf
# Si necesitas incluir documentación Word, usa Git LFS:
# git lfs track "*.docx"


# ── ARCHIVOS DE MEDIA SUBIDOS ─────────────────────────────────────────────────
