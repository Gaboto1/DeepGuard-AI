# ============================================================
# DeepGuard AI — Variables de entorno para la API en Render
# Copiar como .env y rellenar los valores reales.
# NUNCA subir este archivo con valores reales a Git.
# ============================================================

# ── Modo de operación ──────────────────────────────────────
# OBLIGATORIO en Render — desactiva la carga de modelos GPU
API_ONLY=true

# ── Redis externo (Upstash o Aiven) ───────────────────────
# Upstash (plan gratuito — 10.000 req/día, TLS incluido):
#   https://console.upstash.com → Create Database → Copy "Redis URL"
# Formato Upstash: rediss://default:TOKEN@HOST.upstash.io:PORT
REDIS_URL=rediss://default:XXXXXXXXXX@your-db.upstash.io:6379
REDIS_BACKEND=rediss://default:XXXXXXXXXX@your-db.upstash.io:6379

# ── CORS — URL del frontend en Vercel ─────────────────────
# Añadir la URL real de Vercel al desplegar
ALLOWED_ORIGINS_CSV=https://deepguard-ai.vercel.app,http://localhost:3000

# ── Seguridad ──────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
DEEPGUARD_SIGNING_KEY=cambia-esto-por-una-clave-aleatoria-larga

# ── App ────────────────────────────────────────────────────
APP_NAME=DeepGuard AI
VERSION=6.0.0
DEBUG=false
MAX_FILE_SIZE_MB=500
