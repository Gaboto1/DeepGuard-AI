# ============================================================
# DeepFake Detector - Environment Variables
# Copy to .env and configure
# ============================================================

# App
APP_NAME=DeepFake Detector
VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS - Frontend URLs (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File limits
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=uploads
MODELS_DIR=models

# Model config
# Primary model: dima806/deepfake_vs_real_image_detection (ViT - downloads ~350MB)
MODEL_NAME=dima806/deepfake_vs_real_image_detection

# Device: cuda (GPU) or cpu
DEVICE=cuda

# Video analysis
MAX_FRAMES=50
VIDEO_FRAME_INTERVAL=10

# Cleanup uploaded files after analysis (seconds, 0=never)
FILE_CLEANUP_DELAY=3600

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# ─── Suscripciones ────────────────────────────────────────────────────────
# Interruptor de la cuota. Apagado por defecto a proposito: un fallo contando
# cuotas se manifiesta dejando usuarios sin servicio. Enciendelo cuando hayas
# comprobado /api/v1/billing/me en tu despliegue.
BILLING_ENABLED=false

# Clave de firma de las licencias de suscripcion. Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Debe tener 32 caracteres o mas, o las licencias quedan deshabilitadas.
#
# NO reutilices DEEPGUARD_SIGNING_KEY: esa acredita un peritaje y esta
# autoriza un cobro. Compartirlas significa que comprometer la facturacion
# compromete la prueba forense.
DEEPGUARD_BILLING_KEY=

# Pasarela de pago. Sin estas variables la pasarela correspondiente no
# aparece y solo queda la simulada, que no cobra nada.
# Ver reports/MODELO_DE_NEGOCIO.md seccion 4 antes de elegir: la
# disponibilidad de Stripe para empresas chilenas es dudosa.
FLOW_API_KEY=
FLOW_SECRET_KEY=
MERCADOPAGO_ACCESS_TOKEN=
