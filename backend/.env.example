# ============================================================
# DeepFake Detector - Environment Variables
# Copy to .env and configure
# ============================================================

# App
APP_NAME=DeepFake Detector
VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# CORS - Frontend URLs (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File limits
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=uploads
MODELS_DIR=models

# Model config
# Primary model: dima806/deepfake_vs_real_image_detection (ViT - downloads ~350MB)
MODEL_NAME=dima806/deepfake_vs_real_image_detection

# Device: cuda (GPU) or cpu
DEVICE=cuda

# Video analysis
MAX_FRAMES=50
VIDEO_FRAME_INTERVAL=10

# Cleanup uploaded files after analysis (seconds, 0=never)
FILE_CLEANUP_DELAY=3600

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
