# ============================================================
# DeepGuard AI — Variables de entorno para el Worker GPU local
# Copiar como .env en la máquina con GPU y rellenar valores.
# ============================================================

# ── Modo de operación ──────────────────────────────────────
# El worker NUNCA debe tener API_ONLY=true
API_ONLY=false

# ── Redis externo (misma instancia que la API en Render) ───
# Mismas URLs que en .env.production.example
REDIS_URL=rediss://default:XXXXXXXXXX@your-db.upstash.io:6379
REDIS_BACKEND=rediss://default:XXXXXXXXXX@your-db.upstash.io:6379

# ── Modelos HuggingFace ────────────────────────────────────
TRANSFORMERS_CACHE=./models
HF_HOME=./models
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ── Seguridad — misma clave que la API ────────────────────
DEEPGUARD_SIGNING_KEY=cambia-esto-por-una-clave-aleatoria-larga

# ── GPU ────────────────────────────────────────────────────
DEVICE=cuda

# ── App ────────────────────────────────────────────────────
APP_NAME=DeepGuard AI
VERSION=6.0.0
DEBUG=false
